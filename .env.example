# AWS credentials for an account/role with Bedrock access to Nova Sonic.
# Create an access key in IAM, and make sure Nova Sonic model access is
# enabled for your account in the Bedrock console for AWS_REGION below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if you're using temporary/STS credentials.
AWS_SESSION_TOKEN=

# Nova 2 Sonic (the default model) is available in: us-east-1, us-west-2, ap-northeast-1
AWS_REGION=us-east-1

# Your AWS Bedrock AgentCore Gateway's MCP endpoint. This is a SigV4/IAM-
# protected endpoint, not an open MCP server — bot.py signs requests to it
# using the AWS credentials above, via AWS's own mcp-proxy-for-aws, spawned
# as a local subprocess. The AWS_ACCESS_KEY_ID/SECRET above must belong to a
# principal the gateway's IAM policy allows to invoke it.
MCP_SERVER_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# --- Slack (agentcore_app/slack_adapter.py only) ---------------------------
# The Slack adapter contains no agent: every turn is one
# bedrock-agentcore:InvokeAgentRuntime call against the runtime below, which
# is the same one that serves the browser voice call. This is the ARN from
# DEPLOY.md — the same value the presign Lambda uses. The principal running
# the adapter needs bedrock-agentcore:InvokeAgentRuntime on it.
AGENT_RUNTIME_ARN=
# Defaults to AWS_REGION; set only if the runtime lives somewhere else.
# AGENT_RUNTIME_REGION=us-west-2

# Local testing: point the adapter at a `python strands_agent.py` running on
# your own machine and every turn becomes a plain POST to it instead of an AWS
# invoke — real Slack messages against code you're still editing, with no
# build, no push and no UpdateAgentRuntime. AGENT_RUNTIME_ARN is then ignored.
# Comment it out to go back to the deployed runtime.
# AGENT_RUNTIME_ENDPOINT=http://127.0.0.1:8080
#
#   SLACK_BOT_TOKEN — your Slack app's "OAuth & Permissions" -> Bot User
#                     OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN — "Basic Information" -> App-Level Tokens, with the
#                     connections:write scope (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Read by the RUNTIME (text_invocations.py), not by the Slack adapter — set it
# in the runtime's env-vars.json too. Nova Sonic is speech-to-speech, so a
# typed turn is answered by this model driving the same gateway tools. Must be
# an inference profile id ("us." / "global." prefix); a bare model id has no
# on-demand throughput and fails with a ValidationException.
# TEXT_MODEL_ID=global.anthropic.claude-opus-5
# TEXT_MODEL_REGION=us-west-2

# How long a Slack thread stays a live conversation with no new messages
# before Ava forgets it and the next message starts fresh (seconds).
# SLACK_IDLE_TIMEOUT_SECONDS=1800

# Ship traces to CloudWatch GenAI Observability. AgentCore Runtime sets this
# for you in the deployed container; a local run (voice or Slack) leaves it
# unset and stays quiet. Set it here to trace the Slack bot from your laptop —
# your IAM principal needs xray:PutTraceSegments.
# AGENT_OBSERVABILITY_ENABLED=true
