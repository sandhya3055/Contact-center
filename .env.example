# AWS credentials for an account/role with Bedrock access to Nova Sonic.
# Create an access key in IAM, and make sure Nova Sonic model access is
# enabled for your account in the Bedrock console for AWS_REGION below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if you're using temporary/STS credentials.
AWS_SESSION_TOKEN=

# Nova 2 Sonic (the default model) is available in: us-east-1, us-west-2, ap-northeast-1
AWS_REGION=us-east-1

# Your AWS Bedrock AgentCore Gateway's MCP endpoint. This is a SigV4/IAM-
# protected endpoint, not an open MCP server — bot.py signs requests to it
# using the AWS credentials above, via AWS's own mcp-proxy-for-aws, spawned
# as a local subprocess. The AWS_ACCESS_KEY_ID/SECRET above must belong to a
# principal the gateway's IAM policy allows to invoke it.
MCP_SERVER_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# --- Slack (agentcore_app/slack_adapter.py only) ---------------------------
# Nothing below is read by bot.py or strands_agent.py; the voice agent runs
# fine without any of it.
#
#   SLACK_BOT_TOKEN — your Slack app's "OAuth & Permissions" -> Bot User
#                     OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN — "Basic Information" -> App-Level Tokens, with the
#                     connections:write scope (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Slack is text, and Nova Sonic is speech-to-speech, so Slack turns are
# answered by Claude on Bedrock driving the same gateway tools. Leave unset
# for the default (global.anthropic.claude-opus-5).
# TEXT_MODEL_ID=global.anthropic.claude-opus-5
# TEXT_MODEL_REGION=us-west-2

# How long a Slack thread stays a live conversation with no new messages
# before Ava forgets it and the next message starts fresh (seconds).
# SLACK_IDLE_TIMEOUT_SECONDS=1800
