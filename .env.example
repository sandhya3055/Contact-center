# AWS credentials for an account/role with Bedrock access to Nova Sonic.
# Create an access key in IAM, and make sure Nova Sonic model access is
# enabled for your account in the Bedrock console for AWS_REGION below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if you're using temporary/STS credentials.
AWS_SESSION_TOKEN=

# Nova 2 Sonic (the default model) is available in: us-east-1, us-west-2, ap-northeast-1
AWS_REGION=us-east-1

# Where bot.py looks for the MCP server exposing get_policy_details,
# register_claim, and escalate_to_human. Points at the local mock server
# (mcp_server/server.py) by default — change this to your real MCP server's
# URL when you're ready to go live.
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
