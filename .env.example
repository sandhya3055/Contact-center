# AWS credentials for an account/role with Bedrock access to Nova Sonic.
# Create an access key in IAM, and make sure Nova Sonic model access is
# enabled for your account in the Bedrock console for AWS_REGION below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if you're using temporary/STS credentials.
AWS_SESSION_TOKEN=

# Nova 2 Sonic (the default model) is available in: us-east-1, us-west-2, ap-northeast-1
AWS_REGION=us-east-1

# Your AWS Bedrock AgentCore Gateway's MCP endpoint. This is a SigV4/IAM-
# protected endpoint, not an open MCP server — bot.py signs requests to it
# using the AWS credentials above, via AWS's own mcp-proxy-for-aws, spawned
# as a local subprocess. The AWS_ACCESS_KEY_ID/SECRET above must belong to a
# principal the gateway's IAM policy allows to invoke it.
MCP_SERVER_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# Where frontend/index.html sends a call. Either your presigned-URL Lambda's
# Function URL / API Gateway URL (deployed), or ws://127.0.0.1:8080/ws when
# running agentcore_app/strands_agent.py on your machine. After editing this,
# run `python frontend/make_config.py` to push it into the page.
CALL_ENDPOINT=ws://127.0.0.1:8080/ws

# --- Human handoff (escalation -> Slack -> agent portal) ------------------
# Slack bot token (xoxb-...) with chat:write, and the channel escalations are
# posted to. Leave either unset and escalations still work — the portal link
# is printed to the server log instead of being posted.
SLACK_BOT_TOKEN=
SLACK_ESCALATION_CHANNEL=#contact-center-escalations
# The origin the Slack link points at, i.e. where this app is reachable from
# whoever clicks it in Slack.
PORTAL_BASE_URL=http://127.0.0.1:8080
# How long an ended call stays readable in the agent portal (seconds).
HANDOFF_RETENTION_SECONDS=1800
# Set to any secret string to enable /portal/queue?token=... — a list of this
# instance's calls with a link into each escalated one, for when the Slack
# message didn't arrive and the log line scrolled away. Off while unset.
HANDOFF_ADMIN_TOKEN=
# The DynamoDB table the agent portal reads an escalation's queue row from
# (status, priority, TTL). Same table the gateway's escalate tool writes.
#
# This app needs dynamodb:GetItem *and dynamodb:UpdateItem* on it: when a call
# escalates it stamps the row with that call's portal keys (the memory session
# to read the conversation from, and a hash of the portal token), which is what
# lets lambda/portal_context_handler.py serve a portal hosted off this
# container. Without UpdateItem everything here still works and only that
# hosted portal can't resolve the call — you'll see one line in the log saying
# so per escalation.
ESCALATIONS_TABLE=escalations
# Region for that table and for AgentCore Memory reads; both default to AWS_REGION.
# ESCALATIONS_REGION=
# MEMORY_REGION=
# Only needed when the portal page is hosted somewhere other than this app
# (e.g. AWS Amplify — see amplify.yml). Comma-separated browser origins allowed
# to call the portal API and open the portal WebSocket. Unset = same-origin
# only, which is how a local run works. Set it and both are enforced: CORS for
# the fetch, and an explicit Origin check on the socket (WebSockets are exempt
# from the same-origin policy, so that check is the only thing stopping another
# site with a leaked token from opening a caller's audio bridge).
PORTAL_ALLOWED_ORIGINS=

# --- Observability and cost ----------------------------------------------
# All of this is optional; unset, the agent logs and traces exactly as before.
# See agentcore_app/observability.py for what each one changes.

# Log verbosity for this app's own structured JSON lines.
LOG_LEVEL=INFO
# Strands' verbosity, separate on purpose: at DEBUG it logs every Nova Sonic
# frame including base64 audio. Useful for one reproduction, ruinous as a
# standing setting — it is also the only way to see a raw `usageEvent` if you
# ever need to re-check the token field names.
STRANDS_LOG_LEVEL=INFO

# What a token costs, in USD per 1,000,000 tokens, per modality. Nova Sonic
# bills speech and text at very different rates, so all four are needed for a
# cost figure to mean anything.
#
# Deliberately has no default. With this unset every call still records its
# token counts and the ledger reports `cost_priced: false`; no CallCostUsd
# metric is published, so nobody ends up reading a fabricated $0 as "calls are
# cheap".
#
# Must be valid JSON with all four keys and REAL NUMBERS. A malformed value is
# treated the same as an unset one -- the agent logs `pricing.config_invalid`
# at ERROR and carries on without cost, rather than failing a call over it. If
# ledger lines say `cost_priced: false` while this is set, that log line is the
# first place to look.
#
# The values below are the us-west-2 rates derived from this account's own
# Cost Explorer (cost / UsageQuantity per NovaSonic2.0 usage type, with
# quantity in units of 1,000 tokens -- the speech rates come out exactly round,
# which is what makes that unit certain). Confirm against the Bedrock pricing
# page before trusting them for anything that matters, and re-derive if you
# change BEDROCK_REGION -- us-east-1 prices text differently (0.33 / 2.75).
NOVA_SONIC_PRICES_JSON={"speech_in":3.00,"text_in":0.319,"speech_out":12.00,"text_out":2.651}

# CloudWatch metric namespace for the per-call ledger (EMF).
# EMF_NAMESPACE=Ava/Calls
