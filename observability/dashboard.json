    {
      "type": "log",
      "x": 0,
      "y": 24,
      "width": 24,
      "height": 7,
      "properties": {
        "title": "Call ledger \u2014 one row per finished call",
        "region": "us-west-2",
        "view": "table",
        "query": "SOURCE '/aws/bedrock-agentcore/runtimes/ava_voice_agent-TVSWmk7feq-DEFAULT'\n| fields @timestamp, call_id, outcome, CallDurationSeconds as secs, CallCostUsd as usd, ToolCalls as tools, GateBlocks as gates, InputTokens as tok_in, OutputTokens as tok_out, transcript_turns as turns, usage_mode, cost_priced\n| filter event = \"call.ledger\"\n| sort @timestamp desc\n| limit 50"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 31,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Errors and refusals (agent + tool Lambda)",
        "region": "us-west-2",
        "view": "table",
        "query": "SOURCE '/aws/bedrock-agentcore/runtimes/ava_voice_agent-TVSWmk7feq-DEFAULT' | SOURCE '/aws/lambda/insurarncae-voice-agent-mcp-tool'\n| fields @timestamp, service, call_id, session_id, event, msg, error\n| filter level in [\"ERROR\", \"WARNING\"]\n| sort @timestamp desc\n| limit 50"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 31,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Runtime compute per session \u2014 seconds_alive vs call duration is where the money goes",
        "region": "us-west-2",
        "view": "table",
        "query": "SOURCE '/aws/vendedlogs/bedrock-agentcore/runtime/USAGE_LOGS/ava_voice_agent-TVSWmk7feq'\n| fields `attributes.session.id` as session_id,\n         `metrics.agent.runtime.vcpu.hours.used` as vcpu_h,\n         `metrics.agent.runtime.memory.gb_hours.used` as gb_h\n| stats count(*) as seconds_alive,\n        sum(vcpu_h) as vcpu_hours,\n        sum(gb_h) as gb_hours,\n        sum(vcpu_h)*0.0895 + sum(gb_h)*0.00945 as compute_usd\n    by session_id\n| sort compute_usd desc\n| limit 25"
      }
    }
  ]
}